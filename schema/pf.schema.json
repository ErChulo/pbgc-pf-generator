{
  "$id": "https://example.invalid/pbgc-pf-generator/pf.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Factor sets for one plan. The app writes one .xlsx tab per set. Synthetic data only.",
  "properties": {
    "factorSets": {
      "items": {
        "properties": {
          "appliesInPbgcAdmin": {
            "description": "BFCF only: the LLM's read of whether PBGC honors this conversion. The app derives the decision itself from fromForm, normalForm, toForm and planMetadata.normalMarriedForm, and fails validation if this value disagrees.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "basis": {
            "description": "Rule in words, e.g. reduction = 1/15 per year early.",
            "type": "string"
          },
          "benAgeMax": {
            "description": "BFCF only: last beneficiary age.",
            "type": [
              "integer",
              "null"
            ]
          },
          "benAgeMin": {
            "description": "BFCF only: first beneficiary age.",
            "type": [
              "integer",
              "null"
            ]
          },
          "benSex": {
            "description": "BFCF only: beneficiary/contingent sex, from the plan documents. Required for a bcv BFCF rule.",
            "enum": [
              "M",
              "F",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "calcMethod": {
            "description": "E.g. MP.",
            "type": [
              "string",
              "null"
            ]
          },
          "citation": {
            "properties": {
              "document": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "page": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false
          },
          "deferralMortality": {
            "description": "ERF/LRF only: Y or N, from the plan's definition of the deferral period. Must be null for a BFCF set (BFCFAEQ has no deferral-mortality parameter; its Method argument is the interest method, intMethod).",
            "enum": [
              "Y",
              "N",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "era": {
            "description": "Plan year or era, e.g. 2020.",
            "minLength": 1,
            "type": "string"
          },
          "effectiveFrom": {
            "description": "First date this rule applies, ISO YYYY-MM-DD, or null when the documents give none.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "effectiveTo": {
            "description": "Last date this rule applies, ISO YYYY-MM-DD, or null when still in effect at DOPT.",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "type": [
              "string",
              "null"
            ]
          },
          "fromForm": {
            "description": "BFCF only: form converted from, e.g. SLA.",
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "description": "Unique in the file, e.g. ERF-2020.",
            "minLength": 1,
            "type": "string"
          },
          "interest": {
            "description": "Annual rate as a decimal, e.g. 0.08.",
            "type": [
              "number",
              "null"
            ]
          },
          "intMethod": {
            "description": "BFCF only: the interest method for the BFCFAEQ Method argument. N for a fixed rate, O for the lump sum rate structure, L for 417(e) segment rates, L with a stability period (LPY, LCY, LPQ, LCQ, LM, optional lookback 1-5), or O/N with a stability period (only with LS06SUYYYY or LS12SUYYYY mortality). LPBGC is not available in BFCFAEQ. Must be null for an ERF/LRF set.",
            "type": [
              "string",
              "null"
            ]
          },
          "monthMax": {
            "description": "Last month. ERF/LRF/OTHER only.",
            "type": [
              "integer",
              "null"
            ]
          },
          "monthMin": {
            "description": "First month. ERF/LRF/OTHER only.",
            "type": [
              "integer",
              "null"
            ]
          },
          "monthsCertain": {
            "type": [
              "integer",
              "null"
            ]
          },
          "monthsTemp": {
            "description": "BFCF only: temporary period in months (FromMthsTemp). Null means 0.",
            "type": [
              "integer",
              "null"
            ]
          },
          "mortality1": {
            "type": [
              "string",
              "null"
            ]
          },
          "mortalityConfirmed": {
            "description": "True only when the mortality codes were checked against the ATPBGC MORTNAME table. A code not in the app's known list fails validation unless this is true.",
            "type": [
              "boolean",
              "null"
            ]
          },
          "mortality2": {
            "type": [
              "string",
              "null"
            ]
          },
          "normalForm": {
            "description": "Normal single form as the documents write it: SLA, a certain-and-continuous form (3CC, 5CC, ...), or a certain-only form (3CO, 5CO, ...). The app maps it to its BCV code (nCC -> SLA with n*12 months certain; nCO -> CTN with n*12 months certain).",
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "nra": {
            "description": "Normal retirement age.",
            "type": [
              "integer",
              "null"
            ]
          },
          "partAgeMax": {
            "description": "BFCF only: last participant age.",
            "type": [
              "integer",
              "null"
            ]
          },
          "partAgeMin": {
            "description": "BFCF only: first participant age.",
            "type": [
              "integer",
              "null"
            ]
          },
          "partSex": {
            "description": "Participant sex, from the plan documents. Required for a bcv rule.",
            "enum": [
              "M",
              "F",
              null
            ],
            "type": [
              "string",
              "null"
            ]
          },
          "rule": {
            "description": "How the app writes the formula. Null only when status is missing.",
            "properties": {
              "denominator": {
                "description": "linear only: months per full year, e.g. 180.",
                "type": "number"
              },
              "firstDenominator": {
                "description": "stepped only.",
                "type": "number"
              },
              "firstMonths": {
                "description": "stepped only.",
                "type": "integer"
              },
              "function": {
                "description": "bcv only.",
                "enum": [
                  "ERFAEQ",
                  "LRFAEQ",
                  "BFCFAEQ"
                ],
                "type": "string"
              },
              "kind": {
                "enum": [
                  "linear",
                  "stepped",
                  "bcv"
                ],
                "type": "string"
              },
              "secondDenominator": {
                "description": "stepped only.",
                "type": "number"
              }
            },
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false
          },
          "ruleText": {
            "description": "The plan's own words for the rule, quoted short from the document. Required when status is present. The formula is translated from this.",
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "present",
              "notApplicable",
              "missing",
              "ambiguous",
              "conditional"
            ],
            "type": "string"
          },
          "survivorPct": {
            "description": "BFCF only: survivor percent for the to-form (JS50 -> 0.5). Null means derive it from toForm when it is a JS form.",
            "type": [
              "number",
              "null"
            ]
          },
          "table": {
            "description": "A factor table printed in the plan documents, copied semantically. Null when no table was found.",
            "properties": {
              "kind": {
                "enum": [
                  "months",
                  "grid"
                ],
                "type": "string"
              },
              "rows": {
                "items": {
                  "properties": {
                    "benAge": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "citation": {
                      "properties": {
                        "document": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "page": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "section": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "type": [
                        "object",
                        "null"
                      ],
                      "additionalProperties": false
                    },
                    "factor": {
                      "description": "Factor as printed, e.g. 0.9944.",
                      "type": "number"
                    },
                    "months": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "partAge": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "factor"
                  ],
                  "type": "object",
                  "additionalProperties": false
                },
                "type": "array"
              }
            },
            "required": [
              "kind",
              "rows"
            ],
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false
          },
          "title": {
            "type": "string"
          },
          "toForm": {
            "description": "BFCF only: form converted to, e.g. JS50.",
            "type": [
              "string",
              "null"
            ]
          },
          "type": {
            "enum": [
              "ERF",
              "LRF",
              "BFCF",
              "OTHER"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "era",
          "title",
          "status"
        ],
        "type": "object",
        "additionalProperties": false
      },
      "minItems": 1,
      "type": "array"
    },
    "additionalConversions": {
      "description": "BFCF sets the user adds by hand in the app (a form pair the scraper missed). Same shape as a factorSets entry; type must be BFCF. Included in the workbook by the user's choice, even when PBGC does not honor the pair; the review says so and the audit log records it.",
      "items": {
        "$ref": "#/properties/factorSets/items"
      },
      "type": "array"
    },
    "planMetadata": {
      "properties": {
        "caseNumber": {
          "description": "Text. Leading zeros kept.",
          "minLength": 1,
          "type": "string"
        },
        "dopt": {
          "description": "ISO date, e.g. 2025-06-30.",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "normalMarriedForm": {
          "description": "The plan's normal married form, e.g. JS50, as the plan documents define it. Never assumed. Needed to judge which BFCF sets PBGC honors.",
          "type": [
            "string",
            "null"
          ]
        },
        "planName": {
          "minLength": 1,
          "type": "string"
        },
        "planNumber": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "planName",
        "planNumber",
        "caseNumber",
        "dopt"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "schemaVersion": {
      "description": "Version of this schema, e.g. 0.4.0. The app records it in the audit report and warns when an imported JSON was written for another version.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "planMetadata",
    "factorSets"
  ],
  "title": "PF Generator JSON (draft v0.4.0)",
  "type": "object",
  "additionalProperties": false
}